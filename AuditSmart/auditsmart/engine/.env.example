# Copy to .env (never commit .env). Empty values use the local defaults shown.
ENVIRONMENT=development
# PostgreSQL in servers, e.g. postgresql+psycopg://user:pass@host:5432/auditsmart ; empty = local SQLite
DATABASE_URL=
# Redis for background jobs, e.g. redis://localhost:6379/0 ; empty = in-process runner
REDIS_URL=
# Entra ID: https://login.microsoftonline.com/<tenant-id>/v2.0 ; Supabase: https://<project>.supabase.co/auth/v1
AUTH_ISSUER=
AUTH_AUDIENCE=
# entra | supabase | dev (dev only works when ENVIRONMENT=development)
AUTH_PROVIDER=entra
AUTH_JWKS_URL=
# Supabase legacy HS256 secret or local dev secret (32+ chars). Keep it in .env only.
AUTH_HS256_SECRET=
# Comma-separated front-end origins, e.g. https://auditsmart.lovable.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
# AI is used for drafting text only (prompt 3.7), never for numbers. Key goes in .env from Step 3.7.
# AI drafts observation wording only (prompt 3.7); never calculations.
# AI_PROVIDER: empty (AI off) | stub (offline, deterministic) | gemini | azure_openai
AI_PROVIDER=
AI_MODEL=
# Keys are set only in the deployment's secret store, never in this file, git or chat:
# GEMINI_API_KEY / AZURE_OPENAI_API_KEY / AZURE_OPENAI_ENDPOINT
# file:///path/to/storage (Azure Blob in Stage 7); empty = engine/storage
STORAGE_URL=
MAX_UPLOAD_MB=500
LOG_LEVEL=INFO
