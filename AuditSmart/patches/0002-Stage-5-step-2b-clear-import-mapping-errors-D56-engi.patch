+ALLOWED_FIELDS = tuple(SYNONYMS)
+_MAX_LISTED_HEADERS = 40
+
+
+class MappingError(ValueError):
+    """A mapping override the engine cannot use (D56). ``message`` is plain English and safe
+    to show the user; the API returns it as a 422 and a parse job stores it as its error."""
+
+    user_facing = True
+
+    def __init__(self, message: str) -> None:
+        super().__init__(message)
+        self.message = message
+
+
+def canonical_field(name: str) -> str | None:
+    """'posting_date', 'Posting Date', 'date', 'GL Date' -> 'posting_date'; None if unknown."""
+    if name in SYNONYMS:
+        return name
+    return _SYN_LOOKUP.get(norm_header(name))
+
+
+def _allowed_text() -> str:
+    return "Allowed fields: " + ", ".join(ALLOWED_FIELDS) + "."
+
+
+def _headers_text(headers: Sequence[str]) -> str:
+    shown = [h.lstrip("\ufeff") for h in headers[:_MAX_LISTED_HEADERS]]
+    more = len(headers) - len(shown)
+    return "Columns in the file: " + (", ".join(shown) or "(none)") + (
+        f" (+{more} more)." if more > 0 else ".")
+
+
+def _find_header(name: str, headers: Sequence[str]) -> str | None:
+    """Exact header first, then a single header equal after normalising (case, spaces)."""
+    if name in headers:
+        return name
+    stripped = [h for h in headers if h.lstrip("\ufeff").strip() == name.strip()]
+    if len(stripped) == 1:
+        return stripped[0]
+    key = norm_header(name)
+    loose = [h for h in headers if key and norm_header(h) == key]
+    return loose[0] if len(loose) == 1 else None
+
+
+def _type_name(v: object) -> str:
+    if isinstance(v, bool):
+        return "true/false"
+    if isinstance(v, int | float):
+        return "a number"
+    if isinstance(v, list):
+        return "a list"
+    if isinstance(v, dict):
+        return "an object"
+    return type(v).__name__
+
+
+def normalise_override(override: object, headers: Sequence[str]) -> dict[str, str] | None:
+    """Check and normalise a user mapping override against the file's headers (D56).
+
+    Accepts {field: header} with field names, labels or synonyms ('Posting Date', 'date',
+    'Dr'), and the reversed direction {header: field} when the key is a column of the file
+    and the value names a field. Values are column headers, '' (or null) to unmap a field.
+    Returns {canonical_field: exact_header_or_''}; raises ``MappingError`` listing every
+    problem at once. No value is guessed: an unknown name is an error, never dropped.
+    """
+    if override is None:
+        return None
+    if not isinstance(override, dict):
