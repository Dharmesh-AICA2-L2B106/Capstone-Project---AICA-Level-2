+POST /v1/datasets {engagement_id,file,kind?,mapping_override?} multipart ->202 dataset_id,job_id,sha256,mapping_suggestion,profile,status
+GET /v1/datasets/{dataset_id} ->id,engagement_id,file_name,kind,status,sha256,size_bytes,rows,total_dr,total_cr,mapping,profile,created_at
+PUT /v1/datasets/{dataset_id}/mapping {mapping_override} ->202 job_id,dataset_id,status
+POST /v1/datasets/{dataset_id}/validate q:wait? {tb_dataset_id?} ->202 job_id,dataset_id,status
+GET /v1/datasets/{dataset_id}/errors ->dataset_id,status,critical,warnings,blocked,row_note,errors
+GET /v1/datasets/{dataset_id}/rows q:offset?,limit?,voucher_no?,account_code?,user_id?,date_from?,date_to?,min_amount? ->dataset_id,total,offset,limit,rows
+GET /v1/jobs q:engagement_id?,status?,type?,offset?,limit? ->total,offset,limit,items
+GET /v1/jobs/{job_id} ->id,type,engagement_id?,status,progress,error,result_ref,created_at,started_at,finished_at
+POST /v1/jobs/{job_id}/cancel ->id,type,engagement_id?,status,progress,error,result_ref,created_at,started_at,finished_at
+POST /v1/sample {dataset_id,method?,basis?,account_types?,account_codes?,confidence?,tolerable_misstatement?,expected_misstatement_pct?,size_formula?,sample_size?,key_item_threshold?,strata_boundaries?,num_strata?,seed?} ->201 sample_id,dataset_id,engagement_id,method,status,parameters,cf_value,cf_rule_version,formula_text,n_required,sample_size,seed,random_start,interval,basic_precision,population,top_stratum,key_items,credit_lines_excluded,strata,items,warnings,rationale,engine_version,dataset_hash,rule_versions_used,rules_pending_verification
+GET /v1/samples/{sample_id} ->sample_id,dataset_id,engagement_id,method,status,parameters,cf_value,cf_rule_version,formula_text,n_required,sample_size,seed,random_start,interval,basic_precision,population,top_stratum,key_items,credit_lines_excluded,strata,items,warnings,rationale,engine_version,dataset_hash,rule_versions_used,rules_pending_verification
+POST /v1/je-tests {dataset_id,parameters?} ->202 je_run_id,job_id,status_url,result_url
