/**
 * Appends 5 more formatted slot rows to the 'Meeting Schedule' sheet.
 */
function addFiveMoreSlots() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName("Meeting Schedule");
  if (!sheet) {
    setupMeetingScheduleSheet();
    return;
  }
  
  var lastRow = sheet.getLastRow();
  var startSr = lastRow; // because row 1 is header
  var newRows = [];
  
  for (var i = 1; i <= 5; i++) {
    newRows.push([
      startSr + i - 1,
      "",
      "",
      HR_CC_EMAIL,
      "2026-10-28",
      "02:25 PM",
      "02:45 PM",
      "1-on-1 Performance Review",
      "Ready to Schedule",
      ""
    ]);
  }
  
  sheet.getRange(lastRow + 1, 1, 5, 10).setValues(newRows);
  sheet.getRange(lastRow + 1, 1, 5, 1).setHorizontalAlignment("center");
  sheet.getRange(lastRow + 1, 5, 5, 3).setHorizontalAlignment("center");
  sheet.getRange(lastRow + 1, 9, 5, 1).setHorizontalAlignment("center").setBackground("#f8fafc");
  
  SpreadsheetApp.getUi().alert("Added 5 Slots", "5 new customizable slot rows (Sr. " + startSr + " to " + (startSr + 4) + ") have been added.", SpreadsheetApp.getUi().ButtonSet.OK);
}

/**
 * Resets selected row(s) status back to 'Ready to Schedule' so they can be re-scheduled.
 */
function resetSelectedRowsToReschedule() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName("Meeting Schedule");
  if (!sheet) return;
  
  var range = sheet.getActiveRange();
  if (!range) {
    SpreadsheetApp.getUi().alert("Please select the rows you want to reset.");
    return;
  }
  
  var startRow = Math.max(range.getRow(), 2);
  var numRows = range.getNumRows();
  
  for (var r = startRow; r < startRow + numRows; r++) {
    sheet.getRange(r, 9).setValue("Ready to Schedule").setBackground("#f8fafc").setFontColor("#0f172a");
  }
  
  SpreadsheetApp.getUi().alert("Reset Complete", numRows + " row(s) reset to 'Ready to Schedule'. You can now re-run the invite sender to update them.", SpreadsheetApp.getUi().ButtonSet.OK);
}

/**
 * Loops through 'Meeting Schedule', reads custom dates and start/end times,
 * creates Google Calendar events with Google Meet links, invites employees and CCs HR.
 */
function sendBulkMeetingInvites() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName("Meeting Schedule");
  
  if (!sheet) {
    SpreadsheetApp.getUi().alert("Error", "Sheet 'Meeting Schedule' not found. Please click '1. Generate Flexible Meeting Schedule Template' first.", SpreadsheetApp.getUi().ButtonSet.OK);
    return;
  }
  
  var data = sheet.getDataRange().getValues();
  if (data.length <= 1) {
    SpreadsheetApp.getUi().alert("No Data", "No meeting rows found to schedule.", SpreadsheetApp.getUi().ButtonSet.OK);
    return;
  }
  
  var calendar = CalendarApp.getDefaultCalendar();
  var countScheduled = 0;
  var countSkipped = 0;
  var errors = [];
  
  // Base Web App URL for inclusion in invite description
  var webAppUrl = ScriptApp.getService().getUrl() || "";
  
  for (var r = 1; r < data.length; r++) {
    var row = data[r];
    var empName = String(row[1] || "").trim();
    var empEmail = String(row[2] || "").trim();
    var hrEmail = String(row[3] || "").trim();
    var dateVal = row[4];
    var startTimeVal = row[5];
    var endTimeVal = row[6];
    var baseTitle = String(row[7] || "1-on-1 Performance Review").trim();
    var status = String(row[8] || "").trim();
    
    // Skip if already successfully scheduled and not flagged for update
    if (status === "Scheduled & Invite Sent") {
      countSkipped++;
      continue;
    }
    
    // If row has no employee email, skip it silently (empty slot)
    if (!empEmail) {
      countSkipped++;
      continue;
    }
    
    // Validate email format
    if (empEmail.indexOf("@") === -1) {
      sheet.getRange(r + 1, 9).setValue("Skipped: Invalid Email").setBackground("#fee2e2").setFontColor("#991b1b");
      countSkipped++;
      continue;
    }
    
    try {
      // 1. Parse Start Date and Time flexibly
      var startDateTime = parseFlexibleDateTime(dateVal, startTimeVal, 0);
      
      // 2. Parse End Date and Time (defaults to Start Time + 20 minutes if empty)
      var endDateTime;
      if (endTimeVal && String(endTimeVal).trim() !== "") {
        try {
          endDateTime = parseFlexibleDateTime(dateVal, endTimeVal, 0);
          // If end time is before or equal to start time, default to +20 mins
          if (endDateTime.getTime() <= startDateTime.getTime()) {
            endDateTime = new Date(startDateTime.getTime() + 20 * 60000);
          }
        } catch (e) {
          endDateTime = new Date(startDateTime.getTime() + 20 * 60000);
        }
      } else {
        endDateTime = new Date(startDateTime.getTime() + 20 * 60000);
      }
      
      var tz = Session.getScriptTimeZone() || "GMT";
      var displayDate = Utilities.formatDate(startDateTime, tz, "EEE, dd MMM yyyy");
      var displayStartTime = Utilities.formatDate(startDateTime, tz, "hh:mm a");
      var displayEndTime = Utilities.formatDate(endDateTime, tz, "hh:mm a");
      
      var meetingTitle = baseTitle + ": " + (empName || empEmail) + " - Kochar Consultants Pvt. Ltd";
      
      var description = "" +
        "Hello " + (empName || "Team Member") + ",\n\n" +
        "You are scheduled for your bi-annual 1-on-1 Performance Review discussion for FY 2026-27 H1 with Siddhant Mehta.\n\n" +
        "📅 Meeting Details:\n" +
        "• Date: " + displayDate + "\n" +
        "• Time: " + displayStartTime + " - " + displayEndTime + " (20 Minutes)\n" +
        "• Reviewee: " + (empName ? empName + " (" + empEmail + ")" : empEmail) + "\n" +
        "• Reviewer: Siddhant Mehta (siddhantmehta@kocharconsultants.com)\n\n" +
        "📋 Meeting Agenda:\n" +
        "1. In-depth discussion of your submitted Self-Assessment\n" +
        "2. Review of project performance, client feedback, and technical milestones\n" +
        "3. Joint feedback, ratings, and professional growth action plan\n\n" +
        "⚠️ Important: Please complete and submit your Self-Assessment prior to this meeting." +
        (webAppUrl ? "\nAppraisal Portal Link: " + webAppUrl : "") + "\n\n" +
        "A Google Meet video conference link is attached to this calendar invitation.\n\n" +
        "Best regards,\n" +
        "Kochar Consultants Pvt. Ltd\n" +
        "Information System - Audit | IT Consulting | IT Governance & Compliance";
      
      // Build guest list: Employee + HR
      var guestList = empEmail;
      if (hrEmail && hrEmail.toLowerCase() !== empEmail.toLowerCase()) {
        guestList += "," + hrEmail;
      }
      
      // Create Calendar Event with Google Meet conference
      var event = calendar.createEvent(meetingTitle, startDateTime, endDateTime, {
        description: description,
        guests: guestList,
        sendInvites: true
      });
      
      // Update Sheet with status and Event ID
      sheet.getRange(r + 1, 9).setValue("Scheduled & Invite Sent").setBackground("#dcfce7").setFontColor("#166534").setFontWeight("bold");
      sheet.getRange(r + 1, 10).setValue("ID: " + event.getId().substring(0, 24) + "...");
      countScheduled++;
      
    } catch (err) {
      Logger.log("Error scheduling row " + (r + 1) + ": " + err.message);
      sheet.getRange(r + 1, 9).setValue("Error: " + err.message).setBackground("#fee2e2").setFontColor("#991b1b");
      errors.push("Row " + (r + 1) + " (" + (empName || empEmail) + "): " + err.message);
    }
  }
  
  var summaryMsg = "Bulk Scheduling Complete!\n\n" +
    "• Successfully Scheduled: " + countScheduled + " meetings\n" +
    "• Skipped / Unchanged: " + countSkipped + "\n";
    
  if (errors.length > 0) {
    summaryMsg += "\nIssues encountered:\n" + errors.join("\n");
  } else {
    summaryMsg += "\n✓ Google Meet links were automatically generated for each meeting.\n" +
      "✓ Individual Google Calendar invitations have been emailed to employees.\n" +
      "✓ HR is CC'd on all invitations.";
  }
  
  SpreadsheetApp.getUi().alert("Scheduling Results", summaryMsg, SpreadsheetApp.getUi().ButtonSet.OK);
}

/**
 * Resilient parser that extracts Date and Time from strings, Dates, or numeric serials,
 * with support for arbitrary minute offsets.
 */
function parseFlexibleDateTime(dateInput, timeInput, addMinutes) {
  var year, month, day;
  var tz = Session.getScriptTimeZone() || "GMT";
  
  // 1. Resolve Date
  if (dateInput instanceof Date) {
    year = dateInput.getFullYear();
    month = dateInput.getMonth();
    day = dateInput.getDate();
  } else if (typeof dateInput === "number") {
    var dFromNum = new Date(Math.round((dateInput - 25569) * 86400 * 1000));
    year = dFromNum.getFullYear();
    month = dFromNum.getMonth();
    day = dFromNum.getDate();
  } else if (typeof dateInput === "string" && dateInput.trim() !== "") {
    var dStr = dateInput.trim();
    var ymd = dStr.match(/^(\d{4})[-/.](\d{1,2})[-/.](\d{1,2})$/);
    if (ymd) {
      year = parseInt(ymd[1], 10);
      month = parseInt(ymd[2], 10) - 1;
      day = parseInt(ymd[3], 10);
    } else {
      var dmy = dStr.match(/^(\d{1,2})[-/.](\d{1,2})[-/.](\d{4})$/);
      if (dmy) {
        day = parseInt(dmy[1], 10);
        month = parseInt(dmy[2], 10) - 1;
        year = parseInt(dmy[3], 10);
      } else {
        var p = new Date(dStr);
        if (isNaN(p.getTime())) {
          throw new Error("Unrecognized date format: '" + dateInput + "'. Use YYYY-MM-DD.");
        }
        year = p.getFullYear();
        month = p.getMonth();
        day = p.getDate();
      }
    }
  } else {
    throw new Error("Missing date in slot.");
  }
  
  // 2. Resolve Time
  var hours = 0;
  var minutes = 0;
  
  if (timeInput instanceof Date) {
    hours = timeInput.getHours();
    minutes = timeInput.getMinutes();
  } else if (typeof timeInput === "number") {
    var totalMin = Math.round(timeInput * 24 * 60);
    hours = Math.floor(totalMin / 60) % 24;
    minutes = totalMin % 60;
  } else if (typeof timeInput === "string" && timeInput.trim() !== "") {
    var tStr = timeInput.trim().replace(".", ":");
    var tm = tStr.match(/^(\d{1,2})(?::(\d{2}))?\s*(AM|PM)?$/i);
    if (!tm) {
      throw new Error("Invalid time format: '" + timeInput + "'. Please use '10:30 AM' or '14:30'.");
    }
    hours = parseInt(tm[1], 10);
    minutes = tm[2] ? parseInt(tm[2], 10) : 0;
    var mer = tm[3] ? tm[3].toUpperCase() : "";
    if (mer === "PM" && hours < 12) hours += 12;
    if (mer === "AM" && hours === 12) hours = 0;
  } else {
    throw new Error("Missing time in slot.");
  }
  
  var result = new Date(year, month, day, hours, minutes, 0, 0);
  if (addMinutes) {
    result = new Date(result.getTime() + addMinutes * 60000);
  }
  return result;
}

