      .addToUi();
  } catch (e) {
    Logger.log("Notice: UI menu not available in standalone execution context.");
  }
}

/**
 * Automatically calculates End Time (+20 mins) whenever the manager enters or
 * edits a Start Time in the 'Meeting Schedule' sheet.
 */
function onEdit(e) {
  try {
    if (!e || !e.range) return;
    var sheet = e.range.getSheet();
    if (sheet.getName() !== "Meeting Schedule") return;
    
    var row = e.range.getRow();
    var col = e.range.getColumn();
    
    // Column 6 is 'Start Time'
    if (col === 6 && row > 1) {
      var startTimeVal = e.range.getValue();
      var endCell = sheet.getRange(row, 7);
      
      if (startTimeVal !== "") {
        try {
          var dummyDate = "2026-10-27";
          var endDt = parseFlexibleDateTime(dummyDate, startTimeVal, 20);
          var formattedEndTime = Utilities.formatDate(endDt, Session.getScriptTimeZone() || "GMT", "hh:mm a");
          endCell.setValue(formattedEndTime);
        } catch (err) {
          // Leave cell for manual editing if custom format
        }
      }
      
      // If row was previously scheduled, flag it for update
      var statusCell = sheet.getRange(row, 9);
      if (String(statusCell.getValue()).indexOf("Scheduled") !== -1) {
        statusCell.setValue("Ready to Reschedule (Time Changed)").setBackground("#fef9c3").setFontColor("#854d0e");
      }
    }
    
    // Column 5 is 'Date'
    if (col === 5 && row > 1) {
      var statusCell2 = sheet.getRange(row, 9);
      if (String(statusCell2.getValue()).indexOf("Scheduled") !== -1) {
        statusCell2.setValue("Ready to Reschedule (Date Changed)").setBackground("#fef9c3").setFontColor("#854d0e");
      }
    }
  } catch (err) {
    Logger.log("onEdit handler error: " + err.message);
  }
}

/**
 * Creates and formats the 'Meeting Schedule' sheet tab with 15 flexible, editable slots.
 * Includes dropdown validation for Oct 27 & 28 dates, suggested 20-min slots, and
 * allows total freedom to edit any cell (names, emails, dates, start/end times).
 */
function setupMeetingScheduleSheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheetName = "Meeting Schedule";
  var sheet = ss.getSheetByName(sheetName);
  
  if (!sheet) {
    sheet = ss.insertSheet(sheetName);
  }
  
  sheet.clear();
  
  var headers = [
    "Sr.",
    "Employee Name",
    "Employee Email",
    "HR Email (CC)",
    "Date (YYYY-MM-DD)",
    "Start Time",
    "End Time (+20m)",
    "Meeting Title",
    "Status",
    "Google Meet & Event ID"
  ];
  
  sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
  var headerRange = sheet.getRange(1, 1, 1, headers.length);
  headerRange.setFontWeight("bold");
  headerRange.setBackground("#0f766e");
  headerRange.setFontColor("#ffffff");
  headerRange.setHorizontalAlignment("center");
  headerRange.setVerticalAlignment("middle");
  sheet.setRowHeight(1, 38);
  sheet.setFrozenRows(1);
  
  // 15 Suggested starting slots (8 on Oct 27, 7 on Oct 28, respecting 1-2 PM lunch)
  // All fields are 100% editable by the manager at any time!
