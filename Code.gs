/**
 * Safely accesses or creates a subfolder inside DRIVE_FOLDER_ID.
 */
function getOrCreateDriveFolder(parentFolderId, subfolderName) {
  var parentFolder;
  try {
    parentFolder = DriveApp.getFolderById(parentFolderId);
  } catch (e) {
    Logger.log("Warning: Could not access DRIVE_FOLDER_ID (" + parentFolderId + "): " + e.message + ". Falling back to Drive Root.");
    parentFolder = DriveApp.getRootFolder();
  }
  
  var folders = parentFolder.getFoldersByName(subfolderName);
  if (folders.hasNext()) {
    return folders.next();
  } else {
    return parentFolder.createFolder(subfolderName);
  }
}

/**
 * VIEW 3: Submits Employee Digital Acknowledgment.
 * Records digital signature and timestamp, sets status to 'Completed & Signed',
 * generates clean HTML-to-PDF, saves to DRIVE_FOLDER_ID subfolder, and emails PDF to Employee and MANAGER_EMAIL.
 */
function submitEmployeeAcknowledgment(ackData) {
  try {
    var record = getRecordById(ackData.submissionId);
    if (!record) {
      throw new Error("Submission record not found for ID: " + ackData.submissionId);
    }
    
    var sheet = getReviewsSheet();
    var rowIndex = record.rowIndex;
    var signatureTimestamp = formatDateTime(new Date());
    var digitalSignature = record.employeeName + " (" + record.employeeEmail + ")";
    var status = "Completed & Signed";
    
    // Update local record copy for PDF generator
    record.status = status;
    record.digitalSignature = digitalSignature;
    record.signatureTimestamp = signatureTimestamp;
    
    // Determine Review Period Folder Name (e.g., 'FY 2026-27 H1')
    var hCode = (record.reviewType && record.reviewType.indexOf("1") !== -1) ? "H1" : "H2";
    var subfolderName = record.financialYear + " " + hCode;
    var pdfFileName = record.employeeName + " - " + subfolderName + ".pdf";
    
    // Generate Styled PDF
    var pdfHtml = generateReviewPdfHtml(record);
    var htmlBlob = Utilities.newBlob(pdfHtml, MimeType.HTML, pdfFileName + ".html");
    var pdfBlob = htmlBlob.getAs(MimeType.PDF).setName(pdfFileName);
    
    // Save to Google Drive
    var targetFolder = getOrCreateDriveFolder(DRIVE_FOLDER_ID, subfolderName);
    var pdfFile = targetFolder.createFile(pdfBlob);
    var pdfUrl = pdfFile.getUrl();
    
    // Try setting viewer access if domain policy allows
    try {
      pdfFile.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    } catch (shareErr) {
      Logger.log("Notice: File sharing restricted by Workspace domain policy.");
    }
    
    // Update Google Sheet columns:
    // 3: Status
    // 23: Digital Signature
    // 24: Signature Timestamp
    // 25: PDF URL
    sheet.getRange(rowIndex, 3).setValue(status);
    sheet.getRange(rowIndex, 23).setValue(digitalSignature);
    sheet.getRange(rowIndex, 24).setValue(signatureTimestamp);
    sheet.getRange(rowIndex, 25).setValue(pdfUrl);
    
    // Email final PDF to both Employee and Manager
    sendFinalSignedReviewEmail({
      employeeName: record.employeeName,
      employeeEmail: record.employeeEmail,
      reviewedBy: record.reviewedBy,
      reviewPeriod: record.reviewPeriod,
      avgSelfRating: record.avgSelfRating,
      avgManagerRating: record.avgManagerRating,
      signatureTimestamp: signatureTimestamp,
      pdfBlob: pdfBlob,
      pdfUrl: pdfUrl
    });
    
    return {
      success: true,
      submissionId: record.submissionId,
      pdfUrl: pdfUrl,
      signatureTimestamp: signatureTimestamp,
      message: "Review finalized and digitally signed! An official copy of your PDF review has been emailed to you and your manager."
    };
  } catch (err) {
    Logger.log("Error in submitEmployeeAcknowledgment: " + err.toString());
    return {
      success: false,
      message: "Failed to finalize acknowledgment: " + err.message
    };
  }
}

