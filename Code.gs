/**
 * Main Web App Entry Point (Routes Views via Query Parameters)
 * Default: Employee Self-Assessment View
 * ?mode=manager&id=XYZ: Manager 1-on-1 Review View
 * ?mode=acknowledge&id=XYZ: Employee Digital Acknowledgment View
 */
function doGet(e) {
  var template = HtmlService.createTemplateFromFile("Index");
  
  var mode = (e && e.parameter && e.parameter.mode) ? String(e.parameter.mode).toLowerCase().trim() : "employee";
  var id = (e && e.parameter && e.parameter.id) ? String(e.parameter.id).trim() : "";
  
  var record = null;
  var errorMessage = "";
  
  if (id) {
    try {
      record = getRecordById(id);
      if (!record) {
        errorMessage = "Performance Review record not found for ID: " + id + ". Please verify your link.";
      }
    } catch (err) {
      errorMessage = "Error retrieving review record: " + err.toString();
    }
  } else if (mode === "manager" || mode === "acknowledge") {
    errorMessage = "Missing Submission ID. Please use the direct link sent to your email to access this review.";
  }
  
  template.mode = mode;
  template.submissionId = id;
  template.record = record;
  template.errorMessage = errorMessage;
  template.jobAreas = JOB_AREAS;
  
  return template.evaluate()
    .setTitle("Employee Performance Review | " + (record ? record.employeeName + " (" + record.reviewPeriod + ")" : "Bi-Annual System"))
    .addMetaTag("viewport", "width=device-width, initial-scale=1")
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

/**
 * Accesses or creates the designated Sheet in the active Google Spreadsheet.
 * Automatically initializes and formats headers on the first run.
 */
function getReviewsSheet() {
  var ss;
  try {
    ss = SpreadsheetApp.getActiveSpreadsheet();
  } catch (e) {
    ss = null;
  }
  
  if (!ss) {
    throw new Error("No active Google Spreadsheet found. Ensure this script is bound to a Google Sheet (open Google Sheets -> Extensions -> Apps Script).");
  }
  
  var sheet = ss.getSheetByName(SHEET_NAME);
  if (!sheet) {
    // If first sheet is empty and named Sheet1, reuse it; otherwise insert new sheet
    var sheets = ss.getSheets();
    if (sheets.length === 1 && sheets[0].getLastRow() === 0) {
      sheet = sheets[0];
      sheet.setName(SHEET_NAME);
    } else {
      sheet = ss.insertSheet(SHEET_NAME);
    }
  }
  
  // Initialize headers if empty
  if (sheet.getLastRow() === 0) {
    initSheetHeaders(sheet);
  }
  
  return sheet;
}

/**
 * Sets up and styles the header row in the Google Sheet.
 */
function initSheetHeaders(sheet) {
  sheet.getRange(1, 1, 1, HEADERS.length).setValues([HEADERS]);
  
  var headerRange = sheet.getRange(1, 1, 1, HEADERS.length);
  headerRange.setFontWeight("bold");
  headerRange.setBackground("#1e3a8a");
  headerRange.setFontColor("#ffffff");
  headerRange.setHorizontalAlignment("center");
  headerRange.setVerticalAlignment("middle");
  sheet.setRowHeight(1, 38);
  sheet.setFrozenRows(1);
  
  // Set default column widths for readability
  sheet.setColumnWidth(1, 280); // Submission ID
  sheet.setColumnWidth(2, 160); // Submission Date
  sheet.setColumnWidth(3, 180); // Status
  sheet.setColumnWidth(4, 180); // Employee Name
  sheet.setColumnWidth(5, 220); // Employee Email
  sheet.setColumnWidth(6, 160); // Designation
  sheet.setColumnWidth(7, 120); // Financial Year
  sheet.setColumnWidth(8, 160); // Review Type
  sheet.setColumnWidth(9, 200); // Review Period
  sheet.setColumnWidth(10, 200); // Trainings JSON
  sheet.setColumnWidth(11, 240); // Other Learnings
  sheet.setColumnWidth(12, 200); // Projects JSON
  sheet.setColumnWidth(13, 220); // Ratings JSON
  sheet.setColumnWidth(14, 130); // Avg Self
  sheet.setColumnWidth(15, 140); // Avg Manager
  sheet.setColumnWidth(20, 250); // Manager Remarks
  sheet.setColumnWidth(21, 160); // Reviewed By
  sheet.setColumnWidth(25, 260); // PDF URL
}

/**
 * Safely parses JSON strings with a fallback default.
 */
function safeJsonParse(jsonString, fallback) {
  if (!jsonString || typeof jsonString !== "string") return fallback;
  try {
    return JSON.parse(jsonString);
  } catch (err) {
    return fallback;
  }
}

/**
 * Formats a Date object to a readable string (e.g., 2026-10-26 14:30:00).
 */
function formatDateTime(date) {
  var d = date || new Date();
  var tz = Session.getScriptTimeZone() || "GMT";
  return Utilities.formatDate(d, tz, "yyyy-MM-dd HH:mm:ss");
}

/**
 * Retrieves a performance review record by its unique submissionId.
 */
function getRecordById(submissionId) {
  if (!submissionId) return null;
  var sheet = getReviewsSheet();
  var data = sheet.getDataRange().getValues();
  if (data.length <= 1) return null;
  
  var targetId = String(submissionId).trim();
  
  for (var r = 1; r < data.length; r++) {
    var row = data[r];
    if (String(row[0]).trim() === targetId) {
      return {
        rowIndex: r + 1,
        submissionId: String(row[0]),
        submissionDate: row[1] instanceof Date ? formatDateTime(row[1]) : String(row[1]),
        status: String(row[2]),
        employeeName: String(row[3]),
        employeeEmail: String(row[4]),
        designation: String(row[5]),
        financialYear: String(row[6]),
        reviewType: String(row[7]),
        reviewPeriod: String(row[8]),
        trainings: safeJsonParse(row[9], []),
        otherLearnings: String(row[10] || ""),
        projects: safeJsonParse(row[11], []),
        ratings: safeJsonParse(row[12], []),
        avgSelfRating: row[13] !== "" ? Number(row[13]) : null,
        avgManagerRating: row[14] !== "" ? Number(row[14]) : null,
        strengthsAccomplishments: String(row[15] || ""),
        areasImprovement: String(row[16] || ""),
        actionPlan: String(row[17] || ""),
        previousPlanStatus: String(row[18] || ""),
        managerOverallRemarks: String(row[19] || ""),
        reviewedBy: String(row[20] || ""),
        reviewDate: row[21] instanceof Date ? formatDateTime(row[21]) : String(row[21] || ""),
        digitalSignature: String(row[22] || ""),
        signatureTimestamp: row[23] instanceof Date ? formatDateTime(row[23]) : String(row[23] || ""),
        pdfUrl: String(row[24] || "")
      };
    }
  }
  
  return null;
}

/**
 * VIEW 1: Submits Employee Self-Assessment.
 * Generates submissionId, appends row to Google Sheet, and emails Manager Review link to MANAGER_EMAIL.
 */
function submitSelfAssessment(formData) {
  try {
    var sheet = getReviewsSheet();
    var submissionId = Utilities.getUuid();
    var submissionDate = formatDateTime(new Date());
    var status = "Submitted - Pending Manager Review";
    
    var financialYear = String(formData.financialYear || "").trim();
    var reviewType = String(formData.reviewType || "").trim();
    var reviewPeriod = financialYear + " " + reviewType;
    
    // Calculate Average Self Rating
    var ratings = formData.ratings || [];
    var totalSelfRating = 0;
    var countSelf = 0;
    for (var i = 0; i < ratings.length; i++) {
      var rVal = Number(ratings[i].selfRating);
      if (!isNaN(rVal) && rVal > 0) {
        totalSelfRating += rVal;
        countSelf++;
      }
    }
    var avgSelfRating = countSelf > 0 ? (totalSelfRating / countSelf).toFixed(2) : "";
    
    var rowData = [
      submissionId,
      submissionDate,
      status,
      String(formData.employeeName || "").trim(),
      String(formData.employeeEmail || "").trim(),
      String(formData.designation || "").trim(),
      financialYear,
      reviewType,
      reviewPeriod,
      JSON.stringify(formData.trainings || []),
      String(formData.otherLearnings || "").trim(),
      JSON.stringify(formData.projects || []),
      JSON.stringify(ratings),
      avgSelfRating,
      "", // avgManagerRating (empty initially)
      String(formData.strengthsAccomplishments || "").trim(),
      String(formData.areasImprovement || "").trim(),
      String(formData.actionPlan || "").trim(),
      String(formData.previousPlanStatus || "").trim(),
      "", // managerOverallRemarks
      "", // reviewedBy
      "", // reviewDate
      "", // digitalSignature
      "", // signatureTimestamp
      ""  // pdfUrl
    ];
    
    sheet.appendRow(rowData);
    
    // Prepare Web App URL
    var webAppUrl = ScriptApp.getService().getUrl();
    if (!webAppUrl && formData.clientBaseUrl) {
      webAppUrl = formData.clientBaseUrl;
    }
    var managerReviewLink = webAppUrl + (webAppUrl.indexOf("?") === -1 ? "?" : "&") + "mode=manager&id=" + submissionId;
    
    // Send Notification Email to Manager
    sendManagerNotificationEmail({
      employeeName: formData.employeeName,
      employeeEmail: formData.employeeEmail,
      designation: formData.designation,
      reviewPeriod: reviewPeriod,
      avgSelfRating: avgSelfRating,
      managerReviewLink: managerReviewLink,
      submissionId: submissionId
    });
    
    return {
      success: true,
      submissionId: submissionId,
      reviewPeriod: reviewPeriod,
      message: "Self-assessment submitted successfully! Your manager has been notified via email."
    };
  } catch (err) {
    Logger.log("Error in submitSelfAssessment: " + err.toString());
    return {
      success: false,
      message: "Failed to submit self-assessment: " + err.message
    };
  }
}

