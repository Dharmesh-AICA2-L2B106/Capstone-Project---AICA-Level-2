/**
 * VIEW 2: Submits Manager 1-on-1 Review.
 * Updates row with Manager Ratings, Remarks, Overall Remarks, Reviewed By, Review Date,
 * sets status to 'Pending Employee Sign-off', and emails Employee with direct acknowledgment link.
 */
function submitManagerReview(managerData) {
  try {
    var record = getRecordById(managerData.submissionId);
    if (!record) {
      throw new Error("Submission record not found for ID: " + managerData.submissionId);
    }
    
    var sheet = getReviewsSheet();
    var rowIndex = record.rowIndex;
    
    // Calculate Average Manager Rating
    var ratings = managerData.ratings || [];
    var totalManagerRating = 0;
    var countManager = 0;
    for (var i = 0; i < ratings.length; i++) {
      var rVal = Number(ratings[i].managerRating);
      if (!isNaN(rVal) && rVal > 0) {
        totalManagerRating += rVal;
        countManager++;
      }
    }
    var avgManagerRating = countManager > 0 ? (totalManagerRating / countManager).toFixed(2) : "";
    var reviewDate = formatDateTime(new Date());
    var status = "Pending Employee Sign-off";
    
    // Column indices in sheet (1-based)
    // 3: Status
    // 13: Evaluation Ratings (JSON)
    // 15: Average Manager Rating
    // 20: Overall Manager Remarks
    // 21: Reviewed By
    // 22: Review Date
    sheet.getRange(rowIndex, 3).setValue(status);
    sheet.getRange(rowIndex, 13).setValue(JSON.stringify(ratings));
    sheet.getRange(rowIndex, 15).setValue(avgManagerRating);
    sheet.getRange(rowIndex, 20).setValue(String(managerData.managerOverallRemarks || "").trim());
    sheet.getRange(rowIndex, 21).setValue(String(managerData.reviewedBy || "").trim());
    sheet.getRange(rowIndex, 22).setValue(reviewDate);
    
    // Prepare Web App URL for Acknowledgment
    var webAppUrl = ScriptApp.getService().getUrl();
    if (!webAppUrl && managerData.clientBaseUrl) {
      webAppUrl = managerData.clientBaseUrl;
    }
    var acknowledgeLink = webAppUrl + (webAppUrl.indexOf("?") === -1 ? "?" : "&") + "mode=acknowledge&id=" + record.submissionId;
    
    // Send Notification Email to Employee
    sendEmployeeSignoffEmail({
      employeeName: record.employeeName,
      employeeEmail: record.employeeEmail,
      reviewedBy: managerData.reviewedBy,
      reviewPeriod: record.reviewPeriod,
      avgSelfRating: record.avgSelfRating,
      avgManagerRating: avgManagerRating,
      managerOverallRemarks: managerData.managerOverallRemarks,
      acknowledgeLink: acknowledgeLink,
      submissionId: record.submissionId
    });
    
    return {
      success: true,
      submissionId: record.submissionId,
      message: "Manager review saved successfully! An email with the digital sign-off link has been sent to " + record.employeeEmail + "."
    };
  } catch (err) {
    Logger.log("Error in submitManagerReview: " + err.toString());
    return {
      success: false,
      message: "Failed to save manager review: " + err.message
    };
  }
}

