 */
function onOpen() {
  try {
    var ui = SpreadsheetApp.getUi();
    ui.createMenu("📅 1-on-1 Meeting Scheduler")
      .addItem("1. Generate Flexible Meeting Schedule Template", "setupMeetingScheduleSheet")
